NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (nunca com prefixo NEXT_PUBLIC_) — só usada em rotas de
# servidor (src/app/api/**), nunca chega ao navegador. Pega em
# Supabase > Settings > API Keys > Legacy > service_role (ou "Secret key"
# no formato novo sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# Matrículas que viram administrador automaticamente ao se cadastrar.
# Separe por vírgula se tiver mais de uma. Não é uma senha secreta de
# verdade (o valor fica visível no código do app rodando no navegador),
# apenas um portão de conveniência para o piloto.
NEXT_PUBLIC_ADMIN_MATRICULAS=ADMIN

# Chaves VAPID para notificações push (gere as suas com:
# node -e "console.log(require('web-push').generateVAPIDKeys())")
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

